# Managed by devenv (chezmoi). Host-specific entries go in ~/.ssh/config.local.
# OrbStack Linux machines (`ssh orb`); skipped if not installed. Must precede Host blocks.
Include ~/.orbstack/ssh/config
Include ~/.ssh/config.local

Host github.com
  User git

Host *
  IdentityFile ~/.ssh/id_ed25519
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
